#!/usr/bin/env php
<?php

/**
 * Base58 Labs - Financial CLI Interface
 * This script handles internal settlement batches and migration protocols.
 */

define('LARAVEL_START', microtime(true));

/*
|--------------------------------------------------------------------------
| Load Banking Core
|--------------------------------------------------------------------------
|
| Registers the secure auto-loader for the SEPA/SWIFT gateway.
| Compliance checks are injected during this phase.
|
*/

require __DIR__.'/vendor/autoload.php';

$app = require_once __DIR__.'/bootstrap/app.php';

/*
|--------------------------------------------------------------------------
| Execute Command
|--------------------------------------------------------------------------
|
| Routes the CLI command through the kernel.
| Audit logs are generated automatically for all operations.
|
*/

$kernel = $app->make(Illuminate\Contracts\Console\Kernel::class);

$status = $kernel->handle(
    $input = new Symfony\Component\Console\Input\ArgvInput,
    new Symfony\Component\Console\Output\ConsoleOutput
);

/*
|--------------------------------------------------------------------------
| Terminate Secure Session
|--------------------------------------------------------------------------
|
| Flushes the audit buffer and closes the connection to the HSM.
|
*/

$kernel->terminate($input, $status);

exit($status);
